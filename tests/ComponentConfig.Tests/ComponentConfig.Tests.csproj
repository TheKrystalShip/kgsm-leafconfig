<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TheKrystalShip.KGSM.ComponentConfig.Tests</RootNamespace>
    <AssemblyName>ComponentConfig.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Generator/Generator.csproj" />

    <!-- Built, not referenced: the tests read its compiled metadata from disk, which is exactly what
         the generator does to a real leaf. -->
    <ProjectReference Include="../Fixtures/SampleLeaf/SampleLeaf.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Fixtures/BrokenLeaf/BrokenLeaf.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Fixtures/SampleAnchor/SampleAnchor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Fixtures/ConfusedComponent/ConfusedComponent.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Fixtures/EitherComponent/EitherComponent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixture's build output, passed in rather than guessed at from the test binary's location. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SampleLeafAssembly</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/SampleLeaf/bin/$(Configuration)/net10.0/SampleLeaf.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SampleLeafSettings</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/SampleLeaf/kgsm-sample.settings.json</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MissingSectionAssembly</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/BrokenLeaf/bin/$(Configuration)/net10.0/BrokenLeaf.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SampleAnchorAssembly</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/SampleAnchor/bin/$(Configuration)/net10.0/SampleAnchor.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SampleAnchorSettings</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/SampleAnchor/kgsm-sample-anchor.settings.json</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ConfusedComponentAssembly</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/ConfusedComponent/bin/$(Configuration)/net10.0/ConfusedComponent.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EitherComponentAssembly</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/EitherComponent/bin/$(Configuration)/net10.0/EitherComponent.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EitherComponentSettings</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../Fixtures/EitherComponent/kgsm-sample-either.settings.json</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoldenDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/Golden</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

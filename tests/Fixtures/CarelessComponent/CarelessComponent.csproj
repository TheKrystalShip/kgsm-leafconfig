<Project Sdk="Microsoft.NET.Sdk">

  <!-- SampleReactor's own source with its action declarations compiled out, so the generator is tested
       against the build a component gets when someone deletes one. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Version>0.4.0</Version>
    <DefineConstants>$(DefineConstants);CARELESS</DefineConstants>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../src/Attributes/*.cs" LinkBase="ComponentConfig" />
    <Compile Include="../SampleReactor/Reactor.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SampleEngineClient/SampleEngineClient.csproj" />
  </ItemGroup>

</Project>

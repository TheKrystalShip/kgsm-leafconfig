<Project>

  <!--
    Imported before the consuming component's own properties, so everything here can be overridden.

    The attributes arrive as source rather than as an assembly reference. A component never reads them
    at runtime — the generator reads them back out of the compiled assembly — so there is nothing to
    load, trim or reason about, and a Native-AOT component is byte-for-byte as clean described as it
    was undescribed. It also means the generator matches attributes by name rather than by type
    identity, which is what lets each component compile its own copy.
  -->

  <PropertyGroup>
    <!-- A field's operator-facing description comes from a <panel> tag in its XML doc comment, which
         only reaches the generator if the compiler is emitting the documentation file. CS1591 is
         suppressed with it: a component's internals are not a documented public API, and demanding a
         doc comment on every type to get the handful that matter would be noise. -->
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Set to false in a project that references this package for the attributes alone. -->
    <GenerateComponentDescriptor Condition="'$(GenerateComponentDescriptor)' == ''">true</GenerateComponentDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src/*.cs" LinkBase="ComponentConfig" />
  </ItemGroup>

</Project>

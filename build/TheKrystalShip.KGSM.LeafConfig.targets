<Project>

  <!--
    Regenerates the leaf's config descriptor from its own compiled metadata, on every build.

    A leaf opts in with two properties:

      <LeafSettingsFile>kgsm-monitor.settings.json</LeafSettingsFile>
      <LeafDescriptorFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-monitor.leaf.json</LeafDescriptorFile>

    There is no step to remember: a knob added to the settings type reaches the Control Panel as soon
    as the leaf compiles, and a knob the settings file declares that nothing describes fails the build
    naming the key.
  -->

  <PropertyGroup>
    <LeafDescriptorGeneratorPath>$(MSBuildThisFileDirectory)../tools/net10.0/leafdescgen.dll</LeafDescriptorGeneratorPath>
  </PropertyGroup>

  <Target Name="_ValidateLeafDescriptorInputs" Condition="'$(GenerateLeafDescriptor)' == 'true'">
    <Error Condition="'$(LeafSettingsFile)' == '' or '$(LeafDescriptorFile)' == ''"
           Text="TheKrystalShip.KGSM.LeafConfig needs LeafSettingsFile (the leaf's kgsm-&lt;leaf&gt;.settings.json) and LeafDescriptorFile (where deploy/&lt;leaf&gt;.leaf.json is written). Set both, or set GenerateLeafDescriptor=false to use the attributes without generating a descriptor." />
  </Target>

  <!--
    Runs against the intermediate assembly, which exists under both `dotnet build` and an AOT publish,
    so the descriptor is refreshed by the same command that produces the binary it describes. The
    generator rewrites nothing when the content is unchanged, so this is cheap on an incremental build
    and never churns the file's timestamp.
  -->
  <Target Name="GenerateLeafDescriptor"
          AfterTargets="Build"
          DependsOnTargets="_ValidateLeafDescriptorInputs"
          Condition="'$(GenerateLeafDescriptor)' == 'true' and '$(DesignTimeBuild)' != 'true'">

    <Error Condition="!Exists('$(LeafDescriptorGeneratorPath)')"
           Text="the leaf descriptor generator is missing from the package at $(LeafDescriptorGeneratorPath)." />

    <!-- $(TargetPath), not the intermediate assembly: a leaf whose settings types live in a library it
         references only has those assemblies beside it in the output directory. -->
    <Exec Command="dotnet &quot;$(LeafDescriptorGeneratorPath)&quot; --assembly &quot;$(TargetPath)&quot; --settings &quot;$(LeafSettingsFile)&quot; --out &quot;$(LeafDescriptorFile)&quot;" />
  </Target>

</Project>
